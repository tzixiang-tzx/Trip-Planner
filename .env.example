# Copy to .env and fill in before running the app.

# SQLite by default — the file is created by `npm run setup`.
DATABASE_URL="file:./dev.db"

# Signs the session cookies. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
